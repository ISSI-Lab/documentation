# ==============================================================================
# Development Environment Configuration (.env.dev)
# ==============================================================================
# Instructions:
# Copy this file to .env in project root: cp docs/ops/config-templates/.env.dev .env
# Never commit .env to Git! It is ignored by .gitignore.
# ==============================================================================

# Global Environment
NODE_ENV=development

# Host Port Mappings
FRONTEND_PORT=3939
BACKEND_PORT=5000
MYSQL_PORT=13306

# phpMyAdmin Configuration (Enabled by default in development)
PMA_PORT=28080

# Database Configuration (MySQL 8.0 Service)
DB_HOST=mysql
DB_PORT=3306
DB_USER=docuser
DB_PASSWORD=docpass
DB_NAME=docforge
MYSQL_ROOT_PASSWORD=rootpass

# Email Configuration Encryption Key (Default AES-256-GCM Key)
EMAIL_CONFIG_SECRET=docforge-email-secret-key-2026
