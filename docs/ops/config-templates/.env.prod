# ==============================================================================
# Production Environment Configuration (.env.prod)
# ==============================================================================
# Instructions:
# Copy this file to .env in project root: cp docs/ops/config-templates/.env.prod .env
# Never commit .env to Git! It is ignored by .gitignore.
# ==============================================================================

# Global Environment
NODE_ENV=production

# Certbot Webroot for SSL Validation on Host
CERTBOT_WEBROOT=/var/www/certbot

# Host Port Mappings (Host Nginx reverse-proxies to FRONTEND_PORT)
FRONTEND_PORT=3939
BACKEND_PORT=5000
MYSQL_PORT=53306

# phpMyAdmin Configuration (Disabled by default in production; enable with -pma)
PMA_PORT=28080

# Database Configuration (MySQL 8.0 Service)
# WARNING: Change default credentials for production security!
DB_HOST=mysql
DB_PORT=3306
DB_USER=docuser
DB_PASSWORD=docpass
DB_NAME=docforge
MYSQL_ROOT_PASSWORD=rootpass

# Email Configuration Encryption Key (Default AES-256-GCM Key)
EMAIL_CONFIG_SECRET=docforge-email-secret-key-2026
