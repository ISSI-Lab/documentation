# ==============================================================================
# Global Application Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in the project root: cp docs/ops/config-templates/.env.example .env
# 2. Update the values for your local machine environment.
# 3. Never commit .env to Git! It is ignored by .gitignore.
# ==============================================================================

# Global Environment (development | staging | production)
ENVIRONMENT=development

# Host Port Mappings (change if ports are occupied on your machine)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Frontend Configuration
NODE_ENV=development
VITE_API_URL=http://localhost:8000

# Backend Configuration
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000

# Secret Keys (Generate unique keys for your local instance)
SECRET_KEY=change-this-to-a-secure-random-string-for-local-dev

# Database Configuration (for future DB services)
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=secret_password
DB_NAME=app_db
