# ==============================================================================
# Host Nginx Bootstrap Configuration (Port 80 Only - Pre-SSL Certification)
# Domain: ${APP_DOMAIN}
# Used for initial Let's Encrypt validation before certificates exist on disk.
# ==============================================================================

server {
  listen 80;
  listen [::]:80;
  server_name ${APP_DOMAIN};

  client_max_body_size 20m;

  # Certbot webroot for Let's Encrypt validation
  location /.well-known/acme-challenge/ {
    root ${CERTBOT_WEBROOT};
    try_files $uri =404;
  }

  # Forward traffic to the Docker Container's Nginx port during bootstrap
  location / {
    proxy_pass http://127.0.0.1:${FRONTEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
